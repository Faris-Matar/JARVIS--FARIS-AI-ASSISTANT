# Copy to .env — all optional. With no keys set, the pipeline uses local Ollama.

# Force a provider: claude | openai | ollama  (default: auto-detect)
WB_PROVIDER=

# Claude API (used if set, unless WB_PROVIDER overrides)
ANTHROPIC_API_KEY=
WB_CLAUDE_MODEL=claude-fable-5

# OpenAI (used if set and no Anthropic key)
OPENAI_API_KEY=
WB_OPENAI_MODEL=gpt-4o

# Local Ollama (free fallback / default)
OLLAMA_HOST=http://localhost:11434
WB_OLLAMA_MODEL=llama3.1
