# Copy to .env — ALL OPTIONAL. Jarvis is fully functional with zero API spend:
# local Ollama handles conversation, summaries, tracking, daily updates.
# API keys ADD capability (heavy creative work, complex reasoning, website
# builder pipeline) — they are never required for core function.

# Frontier model for heavy tasks (used only when genuinely needed, and only
# if frontier escalation is enabled in config/jarvis.config.json)
ANTHROPIC_API_KEY=
JARVIS_CLAUDE_MODEL=claude-fable-5
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-4o

# Local model (the default brain)
OLLAMA_HOST=http://localhost:11434
JARVIS_LOCAL_MODEL=llama3.1

# Gmail (optional — enables inbox skill). See docs/ARCHITECTURE.md → Gmail setup.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
